<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template: install.sh fills in __RUNNER__, __SCRIPT__ and __HOME__. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.notes-clipper.watcher</string>
  <key>ProgramArguments</key>
  <array>
    <string>__RUNNER__</string>
    <string>__SCRIPT__</string>
  </array>
  <!-- A capture starts a run as soon as it lands in the inbox; the 15-min
       poll is for scans, retries and the screenshot backlog. -->
  <key>WatchPaths</key>
  <array>
    <string>__HOME__/Downloads/notes-inbox</string>
  </array>
  <key>StartInterval</key>
  <integer>900</integer>
  <key>RunAtLoad</key>
  <true/>
  <key>StandardErrorPath</key>
  <string>__HOME__/Library/Logs/notes-clipper-watcher.log</string>
</dict>
</plist>
