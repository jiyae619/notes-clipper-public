{
  "manifest_version": 3,
  "name": "Notes-Clipper",
  "version": "1.2.0",
  "description": "Collect text and image clips from pages, videos, and newsletters into your notes — or summarize a whole page or video.",
  "action": {
    "default_title": "Open Notes-Clipper",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "permissions": [
    "sidePanel",
    "downloads",
    "scripting",
    "storage",
    "unlimitedStorage",
    "tabs",
    "contextMenus"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
